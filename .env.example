# 로컬 개발 전용 값으로 변경하세요. 실제 비밀값은 커밋하지 마세요.
DB_USERNAME=cruxmate
DB_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3307

# Docker Compose 내부에서 사용할 일반 MySQL 계정입니다. root는 사용할 수 없습니다.
COMPOSE_DB_USERNAME=cruxmate

# 애플리케이션을 Docker 밖에서 실행할 때만 사용합니다.
DB_URL=jdbc:mysql://localhost:3307/cruxmate?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# Base64로 디코딩했을 때 32바이트 이상인 값을 사용하세요.
JWT_SECRET=replace-with-base64-encoded-secret
